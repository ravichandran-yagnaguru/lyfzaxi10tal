# Copy to .env for local development. Real values go in GCP Secret Manager for
# the deployed service — this file is only ever a template, never real secrets.

ANTHROPIC_API_KEY=

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Optional: only set once Firestore is provisioned. When unset, state falls
# back to a local JSON file (local_state.json) so the pipeline is runnable
# before any GCP resources exist.
FIRESTORE_PROJECT_ID=

# Only needed to run manage_schedule.py, once the Cloud Run service exists.
GCP_PROJECT_ID=
GCP_REGION=us-central1
CLOUD_RUN_URL=
SCHEDULER_SERVICE_ACCOUNT_EMAIL=
GEMINI_API_KEY=
